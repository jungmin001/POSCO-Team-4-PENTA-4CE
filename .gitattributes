# 기본: 텍스트 파일은 checkout/commit 시 OS에 맞게 자동 정규화
* text=auto eol=lf

# 스크립트/설정류는 항상 LF 고정
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Windows 전용 스크립트는 CRLF 고정
*.bat text eol=crlf
*.ps1 text eol=crlf

# 바이너리 파일은 diff/merge 대상에서 제외
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
